---
import "../styles/global.css";
import { SITE, SOCIALS } from "../config/site";
import { withBase } from "../lib/base";
import { ICONS } from "../components/icons";
import ThemeToggle from "../components/ThemeToggle.astro";
import ogImage from "../assets/brand/logo.png";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.name, description = SITE.description } = Astro.props;
const ogUrl = new URL(ogImage.src, Astro.site ?? Astro.url.origin);
const socials = SOCIALS.filter((s) => s.href && s.active);

---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("penno-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ThemeToggle />
    <slot />

    
    {
      socials.length > 0 && (
        <nav class="socials" aria-label="Social links">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <svg viewBox="0 0 24 24" fill="none" set:html={ICONS[s.icon]} />
            </a>
          ))}
        </nav>
      )
    }
    

  </body>
</html>

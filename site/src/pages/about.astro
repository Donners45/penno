<style>
  .parallax {
    position: fixed;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: grayscale(25%);
  }

  .page {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 1.5rem 6rem;
  }

  .back {
    align-self: flex-start;
    max-width: 640px;
    width: 100%;
    margin: 0 auto 2rem;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--accent);
  }

  .prose {
    max-width: 640px;
    width: 100%;
    background: rgba(11, 11, 13, 0.55);
    backdrop-filter: blur(3px);
    border: 1px solid var(--border);
    padding: 2.5rem clamp(1.5rem, 4vw, 3rem);
  }

  .prose h1 {
    font-family: "Cinzel", serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
    color: var(--accent);
  }

  .prose p {
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 1.25rem;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }
</style>
